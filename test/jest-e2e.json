{
  "rootDir": "..",
  "testRegex": ".*\\.(e2e|integration)-spec\\.ts$",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {"^(\\.{1,2}/.*)\\.js$": "$1"},
  "transform": {"^.+\\.ts$": ["ts-jest", {"useESM": true, "tsconfig": {"module": "ESNext", "moduleResolution": "bundler"}}]}
}
